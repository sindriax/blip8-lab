{
  "name": "blip8-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Make chiptune sound effects in your browser: coins, jumps, lasers. Randomize, tweak, download the .wav.",
  "keywords": [
    "chiptune",
    "sfx",
    "8-bit",
    "audio",
    "synthesis",
    "webaudio",
    "gamedev"
  ],
  "license": "MIT",
  "author": "sindriax",
  "homepage": "https://blip8.sindriax.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sindriax/blip8-lab.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.9"
  }
}
